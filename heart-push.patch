+/*  push realtime heart rate samples to a user-configured server.
+
+    Gadgetbridge is free software: you can redistribute it and/or modify
+    it under the terms of the GNU Affero General Public License as published
+    by the Free Software Foundation, either version 3 of the License, or
+    (at your option) any later version. */
+package nodomain.freeyourgadget.gadgetbridge.util;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.TimeUnit;
+
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+
+import nodomain.freeyourgadget.gadgetbridge.database.DBHandler;
+
+import nodomain.freeyourgadget.gadgetbridge.GBApplication;
+
+/**
+ * 把手环的实时心率读数送到你自己的服务器(POST /hr)。
+ * <p>
+ * - 读数先进一个内存队列,由单线程发出去,蓝牙线程不等网络。
+ * - 发失败(没网、服务器在重新部署)就留在队列里,下一次一起补发,最多留 MAX_PENDING 条。
+ * - 每次最多发 MAX_BATCH 条,断网很久之后也不会一次塞一个巨大的请求。
+ */
+public final class HeartPusher {
+    private static final Logger LOG = LoggerFactory.getLogger(HeartPusher.class);
+
+    public static final String PREF_ENABLED = "heart_push_enabled";
+    public static final String PREF_URL = "heart_push_url";
+    public static final String PREF_TOKEN = "heart_push_token";
+
+    private static final int MAX_PENDING = 7200;   // 每秒一个 ≈ 2 小时
+    private static final int MAX_BATCH = 600;
+
+    private static final ScheduledExecutorService EXEC = Executors.newSingleThreadScheduledExecutor();
+    private static ScheduledFuture<?> pendingDaily;
+    private static final ArrayDeque<String> PENDING = new ArrayDeque<>();
+    private static long lastErrorLogAt = 0;
+
+    private HeartPusher() {
+    }
+
+    public static boolean isEnabled() {
+        final Prefs prefs = GBApplication.getPrefs();
+        return prefs.getBoolean(PREF_ENABLED, false) && !url().isEmpty();
+    }
+
+    private static String url() {
+        return GBApplication.getPrefs().getString(PREF_URL, "").trim();
+    }
+
+    private static String token() {
+        return GBApplication.getPrefs().getString(PREF_TOKEN, "").trim();
+    }
+
+    /**
+     * @param steps      这一个读数和上一个之间多走的步数
+     * @param totalSteps 手环自己的「今天累计步数」(计步器攒一阵才跳一次,不是一步一报)
+     */
+    public static void push(final int heartRate, final int steps, final int totalSteps, final long timestampMs) {
+        if (heartRate <= 0 || !isEnabled()) {
+            return;
+        }
+        synchronized (PENDING) {
+            PENDING.add("{\"t\":" + timestampMs + ",\"hr\":" + heartRate + ",\"steps\":" + Math.max(0, steps)
+                    + ",\"total\":" + Math.max(0, totalSteps) + "}");
+            while (PENDING.size() > MAX_PENDING) {
+                PENDING.poll();
+            }
+        }
+        EXEC.execute(HeartPusher::flush);
+    }
+
+    private static void flush() {
+        final List<String> batch = new ArrayList<>();
+        synchronized (PENDING) {
+            for (final String s : PENDING) {
+                if (batch.size() >= MAX_BATCH) break;
+                batch.add(s);
+            }
+        }
+        if (batch.isEmpty()) {
+            return;
+        }
+
+        final String body = "{\"samples\":[" + String.join(",", batch) + "]}";
+        if (post(url(), body)) {
+            synchronized (PENDING) {
+                // 只删发出去的那几条:发送期间新进来的读数还在队尾,不动
+                for (final String s : batch) {
+                    if (s.equals(PENDING.peek())) PENDING.poll();
+                    else break;
+                }
+            }
+        }
+    }
+
+    private static boolean post(final String target, final String body) {
+        HttpURLConnection conn = null;
+        try {
+            conn = (HttpURLConnection) new URL(target).openConnection();
+            conn.setConnectTimeout(8000);
+            conn.setReadTimeout(8000);
+            conn.setRequestMethod("POST");
+            conn.setDoOutput(true);
+            conn.setRequestProperty("Content-Type", "application/json");
+            conn.setRequestProperty("Authorization", "Bearer " + token());
+            try (OutputStream os = conn.getOutputStream()) {
+                os.write(body.getBytes(StandardCharsets.UTF_8));
+            }
+            final int code = conn.getResponseCode();
+            if (code >= 200 && code < 300) return true;
+            logThrottled("HTTP " + code);
+        } catch (final Exception e) {
+            logThrottled(e.getClass().getSimpleName() + ": " + e.getMessage());
+        } finally {
+            if (conn != null) conn.disconnect();
+        }
+        return false;
+    }
+
+    // ---- 每日摘要 -------------------------------------------------------------
+    // 手环同步完(ACTION_NEW_DATA)→ 等 20 秒(一次同步会连发好几个)→ 从数据库挑出
+    // 最近的睡眠、整夜心率/血氧、最近两天的日汇总,POST 到 .../daily。
+    // 发失败不重试:下一次同步会再发一份完整的,服务器按时间覆盖。
+
+    /** 和心率同一个服务器:把地址末尾的 /hr 换成 /daily */
+    static String dailyUrl(final String hrUrl) {
+        final String u = hrUrl.replaceAll("/+$", "");
+        return u.endsWith("/hr") ? u.substring(0, u.length() - 3) + "/daily" : u + "/daily";
+    }
+
+    public static synchronized void scheduleDaily() {
+        if (!isEnabled()) return;
+        if (pendingDaily != null) pendingDaily.cancel(false);
+        pendingDaily = EXEC.schedule(HeartPusher::sendDaily, 20, TimeUnit.SECONDS);
+    }
+
+    private static void sendDaily() {
+        final String body;
+        try (DBHandler db = GBApplication.acquireDB()) {
+            body = buildDaily(db.getDatabase(), System.currentTimeMillis());
+        } catch (final Exception e) {
+            LOG.warn("Daily summary build failed", e);
+            return;
+        }
+        if (post(dailyUrl(url()), body)) LOG.info("Daily summary pushed");
+    }
+
+    private static String q(final SQLiteDatabase db, final String sql, final String... args) {
+        try (Cursor c = db.rawQuery(sql, args)) {
+            if (!c.moveToFirst()) return "[]";
+            final StringBuilder sb = new StringBuilder("[");
+            do {
+                if (sb.length() > 1) sb.append(',');
+                sb.append('{');
+                for (int i = 0; i < c.getColumnCount(); i++) {
+                    if (i > 0) sb.append(',');
+                    sb.append('"').append(c.getColumnName(i).toLowerCase(Locale.ROOT)).append("\":");
+                    if (c.isNull(i)) sb.append("null");
+                    else if (c.getType(i) == Cursor.FIELD_TYPE_FLOAT) sb.append(Math.round(c.getDouble(i) * 10) / 10.0);
+                    else sb.append(c.getLong(i));
+                }
+                sb.append('}');
+            } while (c.moveToNext());
+            return sb.append(']').toString();
+        }
+    }
+
+    static String buildDaily(final SQLiteDatabase db, final long nowMs) {
+        final String since = String.valueOf(nowMs - 36 * 3600_000L);
+        // 每段睡眠顺带算出这段时间里手环自己记的心率和血氧(实时流夜里会断,这份不会)
+        final String sleep = q(db,
+                "SELECT s.TIMESTAMP AS start, s.WAKEUP_TIME AS wake, s.TOTAL_DURATION AS total,"
+                        + " s.DEEP_SLEEP_DURATION AS deep, s.LIGHT_SLEEP_DURATION AS light,"
+                        + " s.REM_SLEEP_DURATION AS rem, s.AWAKE_DURATION AS awake,"
+                        + " (SELECT MIN(a.HEART_RATE) FROM XIAOMI_ACTIVITY_SAMPLE a WHERE a.TIMESTAMP BETWEEN s.TIMESTAMP/1000 AND s.WAKEUP_TIME/1000 AND a.HEART_RATE BETWEEN 30 AND 220) AS hr_min,"
+                        + " (SELECT AVG(a.HEART_RATE) FROM XIAOMI_ACTIVITY_SAMPLE a WHERE a.TIMESTAMP BETWEEN s.TIMESTAMP/1000 AND s.WAKEUP_TIME/1000 AND a.HEART_RATE BETWEEN 30 AND 220) AS hr_avg,"
+                        + " (SELECT MAX(a.HEART_RATE) FROM XIAOMI_ACTIVITY_SAMPLE a WHERE a.TIMESTAMP BETWEEN s.TIMESTAMP/1000 AND s.WAKEUP_TIME/1000 AND a.HEART_RATE BETWEEN 30 AND 220) AS hr_max,"
+                        // 血氧两处都可能有:分钟数据里的 SPO2 列,和「手动/自动测量」表(TYPE 18 = 0x12)。两处并起来算
+                        + " (SELECT MIN(v) FROM (SELECT a.SPO2 AS v FROM XIAOMI_ACTIVITY_SAMPLE a WHERE a.TIMESTAMP BETWEEN s.TIMESTAMP/1000 AND s.WAKEUP_TIME/1000 AND a.SPO2 BETWEEN 70 AND 100"
+                        + "   UNION ALL SELECT m.VALUE FROM XIAOMI_MANUAL_SAMPLE m WHERE m.TYPE = 18 AND m.TIMESTAMP BETWEEN s.TIMESTAMP AND s.WAKEUP_TIME AND m.VALUE BETWEEN 70 AND 100)) AS spo2_min,"
+                        + " (SELECT AVG(v) FROM (SELECT a.SPO2 AS v FROM XIAOMI_ACTIVITY_SAMPLE a WHERE a.TIMESTAMP BETWEEN s.TIMESTAMP/1000 AND s.WAKEUP_TIME/1000 AND a.SPO2 BETWEEN 70 AND 100"
+                        + "   UNION ALL SELECT m.VALUE FROM XIAOMI_MANUAL_SAMPLE m WHERE m.TYPE = 18 AND m.TIMESTAMP BETWEEN s.TIMESTAMP AND s.WAKEUP_TIME AND m.VALUE BETWEEN 70 AND 100)) AS spo2_avg"
+                        + " FROM XIAOMI_SLEEP_TIME_SAMPLE s WHERE s.WAKEUP_TIME > ? ORDER BY s.TIMESTAMP",
+                since);
+        // 分期:每条是「从这一刻起换成某个阶段」(5 醒 3 浅 2 深 4 REM 0 不在睡)。
+        // 回笼觉会被手环并进同一晚、汇总被整段重算,服务器靠这份拆回「夜里」和「回笼」
+        final String stages = q(db,
+                "SELECT TIMESTAMP AS t, STAGE AS st FROM XIAOMI_SLEEP_STAGE_SAMPLE WHERE TIMESTAMP > ? ORDER BY TIMESTAMP",
+                String.valueOf(nowMs - 48 * 3600_000L));
+        final String days = q(db,
+                "SELECT TIMESTAMP AS day, STEPS AS steps, HR_RESTING AS hr_resting, HR_AVG AS hr_avg,"
+                        + " HR_MIN AS hr_min, HR_MAX AS hr_max, STRESS_AVG AS stress_avg, STRESS_MAX AS stress_max,"
+                        + " SPO2_AVG AS spo2_avg, SPO2_MIN AS spo2_min, CALORIES AS calories"
+                        + " FROM XIAOMI_DAILY_SUMMARY_SAMPLE ORDER BY TIMESTAMP DESC LIMIT 2");
+        return "{\"t\":" + nowMs + ",\"sleep\":" + sleep + ",\"stages\":" + stages + ",\"days\":" + days + "}";
+    }
+
+    private static void logThrottled(final String what) {
+        final long now = System.currentTimeMillis();
+        if (now - lastErrorLogAt > 60_000) {
+            lastErrorLogAt = now;
+            LOG.warn("Heart push failed ({}), {} samples pending", what, PENDING.size());
+        }
+    }
+}
